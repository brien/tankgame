{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tankgame gameplay definitions, version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tank": {
          "$ref": "#/$defs/TankDefaults"
        },
        "projectile": {
          "$ref": "#/$defs/ProjectileRules"
        },
        "player": {
          "$ref": "#/$defs/PlayerRules"
        },
        "combat": {
          "$ref": "#/$defs/CombatRules"
        },
        "enemy": {
          "$ref": "#/$defs/EnemyRules"
        },
        "input": {
          "$ref": "#/$defs/InputRules"
        },
        "joystick": {
          "$ref": "#/$defs/JoystickRules"
        },
        "special": {
          "$ref": "#/$defs/SpecialRules"
        },
        "landing": {
          "$ref": "#/$defs/LandingRules"
        },
        "enemyBehavior": {
          "$ref": "#/$defs/EnemyBehaviorRules"
        },
        "gameCube": {
          "$ref": "#/$defs/JoystickRules"
        },
        "types": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grey": {
              "$ref": "#/$defs/TankTypeConfig"
            },
            "red": {
              "$ref": "#/$defs/TankTypeConfig"
            },
            "blue": {
              "$ref": "#/$defs/TankTypeConfig"
            },
            "yellow": {
              "$ref": "#/$defs/TankTypeConfig"
            },
            "purple": {
              "$ref": "#/$defs/TankTypeConfig"
            }
          },
          "required": [
            "grey",
            "red",
            "blue",
            "yellow",
            "purple"
          ]
        },
        "difficulties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "easy": {
              "$ref": "#/$defs/DifficultyModifiers"
            },
            "normal": {
              "$ref": "#/$defs/DifficultyModifiers"
            },
            "hard": {
              "$ref": "#/$defs/DifficultyModifiers"
            }
          },
          "required": [
            "easy",
            "normal",
            "hard"
          ]
        },
        "combinations": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/combination"
          }
        }
      },
      "required": [
        "tank",
        "projectile",
        "player",
        "combat",
        "enemy",
        "input",
        "joystick",
        "special",
        "landing",
        "enemyBehavior",
        "gameCube",
        "types",
        "difficulties",
        "combinations"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "definitions"
  ],
  "$defs": {
