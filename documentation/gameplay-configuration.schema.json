      "type": "string",
      "enum": [
        "grey",
        "red",
        "blue",
        "yellow",
        "purple"
      ]
    },
    "typePair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": {
          "$ref": "#/$defs/tankType"
        },
        "secondary": {
          "$ref": "#/$defs/tankType"
        }
      },
      "required": [
        "primary",
        "secondary"
      ]
    },
