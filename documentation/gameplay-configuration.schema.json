        },
        "maxRiseSpeed": {
          "type": "number",
          "maximum": 3.4028234663852886e+38,
          "minimum": 0,
          "description": "World units per second"
        },
        "maxFallSpeed": {
          "type": "number",
          "maximum": 3.4028234663852886e+38,
          "minimum": 0,
          "description": "World units per second"
        },
        "turboEnergyPerSecond": {
