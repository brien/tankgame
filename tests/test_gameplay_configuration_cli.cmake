# Run the real binary without a usable SDL driver: authoring commands must be headless.
set(config "${TEST_DIR}/cli-gameplay-config.json")
set(invalid "${TEST_DIR}/cli-gameplay-invalid.json")
file(REMOVE "${config}" "${invalid}")
function(run_command expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=invalid
        "${GAME}" ${ARGN} WORKING_DIRECTORY "${TEST_DIR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected status ${result}, wanted ${expected}: ${ARGN}\n${output}\n${error}")
    endif()
endfunction()
run_command(0 --help)
run_command(0 --export-gameplay-config "${config}")
run_command(0 --validate-gameplay-config cli-gameplay-config.json)
file(READ "${config}" before)
run_command(1 --export-gameplay-config "${config}")
file(READ "${config}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Export overwrote existing snapshot")
endif()
file(WRITE "${invalid}" "{}")
run_command(1 --validate-gameplay-config "${invalid}")
run_command(1 --gameplay-config "${invalid}")
run_command(1 --gameplay-config "${TEST_DIR}/does-not-exist.json")
run_command(1 --gameplay-config)
run_command(1 --gameplay-config "${config}" --validate-gameplay-config "${config}")
file(REMOVE "${config}" "${invalid}")

# Invalid SDL deliberately stops after configuration selection. Assert the log,
# rather than just the nonzero status, to prove loading/fallback reached SDL.
set(startup_dir "${TEST_DIR}/gameplay-startup-fixture")
file(MAKE_DIRECTORY "${startup_dir}")
function(check_startup expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env SDL_VIDEODRIVER=invalid
        "${GAME}" ${ARGN} WORKING_DIRECTORY "${startup_dir}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    string(FIND "${output}" "${expected}" found)
    string(FIND "${output}" "VideoTask failed to initialize" video_failure)
    if(NOT result EQUAL 1 OR found EQUAL -1 OR video_failure EQUAL -1)
        message(FATAL_ERROR "Startup did not select/fall back as expected: ${expected}\n${output}\n${error}")
    endif()
endfunction()
file(REMOVE "${startup_dir}/gameplay.json")
check_startup("using built-in defaults")
file(WRITE "${startup_dir}/gameplay.json" "{invalid JSON")
check_startup("using built-in defaults")
file(WRITE "${startup_dir}/gameplay.json" "${before}")
check_startup("Loaded gameplay.json (schema version 1)")
file(WRITE "${startup_dir}/alternative.json" "${before}")
check_startup("Loaded alternative.json (schema version 1)" --gameplay-config alternative.json)
file(WRITE "${startup_dir}/alternative.json" "{}")
check_startup("using built-in defaults" --gameplay-config alternative.json)
check_startup("using built-in defaults" --gameplay-config missing.json)
file(REMOVE_RECURSE "${startup_dir}")
